          "name": "Apache HttpComponents Configure Connection",
          "request": {
            "name": "Apache HttpComponents Configure Connection",
            "description": {
              "content": "Update connection pool and timeout configuration for the HTTP client.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configure",
                "connection"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"connectTimeout\": \"<integer>\",\n  \"socketTimeout\": \"<integer>\",\n  \"maxConnections\": \"<integer>\",\n  \"maxConnectionsPerRoute\": \"<integer>\",\n  \"keepAliveTimeout\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ea643481-9f28-430d-87c5-61da372d78cf",
              "name": "Configuration updated",
              "originalRequest": {
                "url": {
                  "path": [
                    "configure",
                    "connection"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "method": "PUT",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectTimeout\": 5000,\n  \"socketTimeout\": 30000,\n  \"maxConnections\": 200,\n  \"maxConnectionsPerRoute\": 20,\n  \"keepAliveTimeout\": 60000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
